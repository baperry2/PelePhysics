ncells = 8 64 8
max_grid_size  = 16
initFromFile = 1
initFile = /projects/safvto/hackathon/ReactEval_latest/plotfile_with_issue
plotfile = plt_
fuel_name = NC12H26
#reactFormat = 1dArray
reactFormat = Array4
chem_integrator = "ReactorCvode"

ode.enforce_forcing_zero=0  #Works only when reactfunc=2
ode.dt  = 3.2e-7
ode.ndt = 1
ode.ode_ncells = 1
ode.reactor_type  = 2 # 1=full e, 2=full h
ode.verbose = 1
ode.use_typ_vals = 0
ode.rtol = 1e-6
ode.atol = 1e-5

# Select Linear solver for CVODE Newton direction
# Options are [CPU] dense_direct / denseAJ_direct / sparse_direct / custom_direct / GMRES / precGMRES
#             [GPU] sparse_direct / magma_direct / GMRES / precGMRES
#cvode.solve_type = fixed_point
cvode.solve_type = GMRES

# If solve_type = precGMRES -> select preconditioner
# Options are [CPU] dense_simplified_AJacobian / sparse_simplified_AJacobian / custom_simplified_AJacobian
#              [GPU] cuSparse_simplified_AJacobian
cvode.precond_type = cuSparse_simplified_AJacobian
cvode.max_order = 4

ode.implicit_solve = 1
#ode.use_erkstep    = 0

amrex.fpe_trap_invalid = 0
amrex.fpe_trap_zero = 1
amrex.fpe_trap_overflow = 1

ode.bdf_nsubsteps=40

